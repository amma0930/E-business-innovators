<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a href="/" class="logo"><span class="logo-mark"><span>e</span></span><span>E&#8209;Business Innovators</span></a>
        <p>The connected growth engine for small and medium businesses &mdash; SEO, AI automation, web, marketing and finance under one roof.</p>
        <a href="/contact/" class="btn btn-lime">Book a discovery call
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
      <div class="foot-col">
        <h4>Company</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/services/">Services</a></li>
          <li><a href="/work/">Our Work</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/blog/">Blog</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>Services</h4>
        <ul>
          {%- for s in services %}
          <li><a href="/services/{{ s.slug }}/">{{ s.name | replace(" Services", "") | replace("Website Development & Design", "Web Development") | replace("AI Voice Receptionist", "Voice Receptionist") }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      <div class="foot-col">
        <h4>Contact</h4>
        <ul class="foot-contact">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3 19.5 19.5 0 01-6-6 19.8 19.8 0 01-3-8.6A2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.7a2 2 0 01-.5 2.1L10 10a16 16 0 006 6l1.5-1.2a2 2 0 012.1-.5c.9.3 1.8.5 2.7.6a2 2 0 011.7 2z"/></svg><a href="tel:{{ site.phone }}">{{ site.phoneDisplay }}</a></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>Remote &mdash; serving the US &amp; beyond</li>
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      <p>&copy; <span id="year"></span> E-Business Innovators. All rights reserved. &middot; <a href="/privacy/">Privacy</a> &middot; <a href="/terms/">Terms</a> &middot; <a href="/cookies/">Cookie Notice</a></p>
      <div class="foot-socials">
        <a data-social="facebook" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 9V7c0-1 .3-1.5 1.6-1.5H18V2h-3c-3 0-4.4 1.6-4.4 4.3V9H8v3.5h2.6V22H14v-9.5h2.7L17 9z"/></svg></a>
        <a data-social="linkedin" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 100 5 2.5 2.5 0 000-5zM3 9h4v12H3zM10 9h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.3c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V21h-4z"/></svg></a>
        <a data-social="instagram" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
        <a data-social="x" aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.5 8.6L23 22h-6.8l-5.3-7-6.1 7H1.7l8-9.2L1 2h7l4.8 6.3zm-2.4 18h1.9L7.6 4H5.6z"/></svg></a>
      </div>
    </div>
  </div>
</footer>
