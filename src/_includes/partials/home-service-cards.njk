{%- import "macros.njk" as m -%}
<div class="svc-grid">
  {%- for s in services %}
  <article class="svc-card">
    <div class="svc-media">{{ m.pic("svc-" + s.slug, "svc-" + s.slug + "-400", 800, 450, 400, 225, "(max-width:768px) 90vw, (max-width:1024px) 45vw, 360px", s.imageAlt, false) }}</div>
    <span class="svc-num">// {{ s.num }}</span>
    <h3>{{ s.name | safe }}</h3>
    <p>{{ s.homeBlurb | safe }}</p>
    <a href="/services/{{ s.slug }}/" class="more">Explore <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
  </article>
  {%- endfor %}
</div>
